<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.ChannelAdapter.WebProviders</RootNamespace>
    <!-- Satellite package — sign-in with an account of a web provider (Google, Apple, Huawei, Yandex,
         VK ID and the rest of OpenIddict.Client.WebIntegration). Keeps the OpenIddict client out of the
         graph of a deployment that does not take the channel. It is not part of the
         Veriqa.Core.BaseChannels metapackage: the standard host references it directly, an embedded
         host adds it explicitly. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.ChannelAdapter.WebProviders</PackageId>
    <Authors>Veriqa</Authors>
    <Title>Google, Apple, Huawei, Yandex and VK ID login by QR code for ASP.NET Core</Title>
    <Description>Sign-in with a Google, Apple, Huawei, Yandex or VK ID account for Veriqa: a channel built on the OpenIddict client and its web providers, enabled by configuration, one channel per registered client (satellite package).</Description>
    <PackageTags>veriqa;authentication;openid-connect;oidc;openiddict;passwordless;passwordless-login;login;auth;sign-in;qr-code;qr-code-login;cross-device-authentication;two-factor-authentication;2fa;mfa;step-up-authentication;openid-connect-provider;identity-provider;sso;aspnetcore;channels;channel-adapter;social-login;google-sign-in;sign-in-with-apple;huawei-id;yandex-id;vk-id;web-providers</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The protocol of every provider is the one OpenIddict describes: the client with its ASP.NET Core
         integration, its HTTP transport and the provider definitions. The server package is referenced
         for its options alone — the signing and encryption keys of the server of the same host, which
         the client takes as its own. The version is the one the auth server references: every OpenIddict
         package of the core is of one version. -->
    <PackageReference Include="OpenIddict.Client.AspNetCore" Version="7.4.0" />
    <PackageReference Include="OpenIddict.Client.SystemNetHttp" Version="7.4.0" />
    <PackageReference Include="OpenIddict.Client.WebIntegration" Version="7.4.0" />
    <PackageReference Include="OpenIddict.Server" Version="7.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
  </ItemGroup>

  <!-- The rules and the script of the page of a channel, a page of the "Core" UI contour: shipped
       inside the assembly and inlined into the generated page, never served over a URL. LogicalName is
       explicit so the resource name does not depend on how the SDK derives it. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Styles\veriqa-web-provider-page.css"
                      LogicalName="Veriqa.Core.ChannelAdapter.WebProviders.UI.Styles.veriqa-web-provider-page.css" />
    <EmbeddedResource Include="UI\Scripts\veriqa-web-provider-page.js"
                      LogicalName="Veriqa.Core.ChannelAdapter.WebProviders.UI.Scripts.veriqa-web-provider-page.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Redis satellite implements the state store of the pages of the channels, an internal port
         of this adapter: the port stays out of the public surface, and its only other implementation
         is the in-process default here. -->
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Redis" />
    <!-- Test friends stay out of the packed assemblies: build/pack-core passes VeriqaPackaging=true. -->
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Redis.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
  </ItemGroup>

</Project>

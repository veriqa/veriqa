<!--
    Razor SDK — so that the AuthServer package ships its client-side static web assets
    (the authentication page's SignalR client) inside the NuGet package. Any host
    embedding Veriqa receives them automatically at
    /_content/Veriqa.Core.AuthServer/... without manually copying files into its own wwwroot.
    The project has no Razor files — the SDK is used only for the static web assets.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.AuthServer</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.AuthServer</PackageId>
    <Authors>Veriqa</Authors>
    <Title>Passwordless login and OpenID Connect (OIDC) server for ASP.NET Core</Title>
    <Description>Passwordless login and authentication for ASP.NET Core: an OpenID Connect (OIDC) provider built on OpenIddict, with login through Telegram, WhatsApp, Instagram, Messenger, WeChat, Viber, MAX or email, and approval of sensitive actions. On a computer, TV or kiosk, your users scan a QR code shown by your website or app; on a phone, they tap a button. Either way, they confirm with one tap in a messaging app they already have.</Description>
    <PackageTags>veriqa;authentication;openid-connect;oidc;openiddict;passwordless;passwordless-login;passwordless-authentication;login;auth;sign-in;qr-code;qr-code-login;cross-device-authentication;two-factor-authentication;2fa;mfa;step-up-authentication;sms-alternative;openid-connect-provider;oidc-server;identity-provider;sso;human-in-the-loop;ai-agent-security;device-flow;aspnetcore;oauth2;authorization-server;telegram-login;telegram-authentication;whatsapp-login;whatsapp-authentication;email-login;magic-link</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Stylesheet of the sign-in window: shipped inside the assembly and inlined into the generated
       page (the page must stay self-contained — SPEC-015 §1), never served over a URL. The token
       layer it relies on lives in Veriqa.Core.ChannelAdapter (shared with the service pages).
       LogicalName is explicit so the resource name does not depend on how the SDK derives it. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Styles\veriqa-auth-page.css"
                      LogicalName="Veriqa.Core.AuthServer.UI.Styles.veriqa-auth-page.css" />
    <!-- Rules of the countdown, shared by the sign-in window and the page of the claims completion. -->
    <EmbeddedResource Include="UI\Styles\veriqa-countdown.css"
                      LogicalName="Veriqa.Core.AuthServer.UI.Styles.veriqa-countdown.css" />
    <!-- Rules of the block showing the message of the start by a code, shared by the pages that show it. -->
    <EmbeddedResource Include="UI\Styles\veriqa-start-code.css"
                      LogicalName="Veriqa.Core.AuthServer.UI.Styles.veriqa-start-code.css" />
    <!-- Rules of the launch pages of the hop: the heading under the icon of the channel and the spare
         start code. -->
    <EmbeddedResource Include="UI\Styles\veriqa-hop-launch.css"
                      LogicalName="Veriqa.Core.AuthServer.UI.Styles.veriqa-hop-launch.css" />
  </ItemGroup>

  <!-- Client script of the sign-in window: shipped inside the assembly and inlined into the
       generated page under the page's CSP nonce, exactly like the stylesheet above — the page
       must stay self-contained (SPEC-015 §1) and never fetches it over a URL. Everything the
       request decides reaches the script through a JSON data block, so the file holds no server
       substitution and is ordinary JavaScript to a linter, an editor and a diff.
       LogicalName is explicit so the resource name does not depend on how the SDK derives it. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Scripts\veriqa-auth-page.js"
                      LogicalName="Veriqa.Core.AuthServer.UI.Scripts.veriqa-auth-page.js" />
    <!-- Watcher of the page of the claims completion: inlined the same way, under that page's nonce. -->
    <EmbeddedResource Include="UI\Scripts\veriqa-claim-completion.js"
                      LogicalName="Veriqa.Core.AuthServer.UI.Scripts.veriqa-claim-completion.js" />
    <!-- Drawing function of the countdown: inlined into both pages above, ahead of their own scripts. -->
    <EmbeddedResource Include="UI\Scripts\veriqa-countdown.js"
                      LogicalName="Veriqa.Core.AuthServer.UI.Scripts.veriqa-countdown.js" />
    <!-- Reaction function of the status block of the pages that follow a transaction to its end:
         inlined into every page carrying the script of the sign-in window and into the launch page,
         ahead of their own scripts. -->
    <EmbeddedResource Include="UI\Scripts\veriqa-status-block.js"
                      LogicalName="Veriqa.Core.AuthServer.UI.Scripts.veriqa-status-block.js" />
    <!-- Copying function of the block showing the message of the start by a code: inlined into the
         pages that show it, ahead of their own scripts. -->
    <EmbeddedResource Include="UI\Scripts\veriqa-start-code.js"
                      LogicalName="Veriqa.Core.AuthServer.UI.Scripts.veriqa-start-code.js" />
  </ItemGroup>

  <!-- Attribution mark under the QR image of the confirmation creation answer: antialiased 8-bit
       truecolor PNGs at seven base heights, pre-rasterized on the development side from the vector
       master in build/qr-attribution-mark (the delivery carries no rasterizer). The set of heights is shared
       with that script and with the resource names the composer reads — change them together.
       LogicalName is explicit so the resource name does not depend on how the SDK derives it. -->
  <ItemGroup>
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-16.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-16.png" />
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-24.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-24.png" />
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-32.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-32.png" />
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-48.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-48.png" />
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-64.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-64.png" />
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-96.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-96.png" />
    <EmbeddedResource Include="UI\Assets\qr-attribution-mark-128.png"
                      LogicalName="Veriqa.Core.AuthServer.UI.Assets.qr-attribution-mark-128.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.4.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.4.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <!-- Relational EF Core: the startup migration service calls Database.IsRelational() and
         Database.MigrateAsync(), both of which live in this package. The reference used to ride in
         transitively through the transaction engine; once the ORM left the engine's package, the
         dependency this assembly actually compiles against is declared where it is used. The
         version is the one the rest of the repository pins, so a consumer of the OpenIddict
         integration resolves a single Relational assembly instead of unifying two. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Initiator Context Check (SPEC-017): User-Agent normalization (a port of the official
         ua-parser). Offline GeoIP is NOT here — its library travels in the
         Veriqa.Core.AuthServer.MaxMind satellite, because the .mmdb database it reads is supplied
         by the deployment and not by this product. -->
    <PackageReference Include="UAParser" Version="3.1.47" />
  </ItemGroup>

  <ItemGroup>
    <!-- The settings resolution mechanism: the auth server declares its own keys and hosts the
         resolution sources built on its public types, so the reference is explicit and does not
         ride in transitively through the transaction engine. -->
    <ProjectReference Include="..\Veriqa.Core.Configuration\Veriqa.Core.Configuration.csproj" />
    <ProjectReference Include="..\Veriqa.Core.Contracts\Veriqa.Core.Contracts.csproj" />
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
    <ProjectReference Include="..\Veriqa.Core.TransactionEngine\Veriqa.Core.TransactionEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The white-label probe composes the QR image of the confirmation answer directly: the composer
         and the module matrix it draws are internal by design, and the probe has to reach the shipped
         assembly compiled with the white-label symbol rather than a copy of the type. -->
    <!-- Test friends stay out of the packed assemblies: build/pack-core passes VeriqaPackaging=true. -->
    <InternalsVisibleTo Include="Veriqa.Core.WhiteLabel.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
  </ItemGroup>

</Project>

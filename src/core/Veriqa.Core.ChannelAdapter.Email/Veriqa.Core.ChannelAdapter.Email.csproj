<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.ChannelAdapter.Email</RootNamespace>
    <!-- Satellite package — the Email channel. Keeps MailKit out of the base package's transitive
         graph, so a deployment that takes only Telegram never receives a mail library. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.ChannelAdapter.Email</PackageId>
    <Authors>Veriqa</Authors>
    <Title>Email login by QR code, magic link and one-tap email authentication for ASP.NET Core</Title>
    <Description>Email login and authentication for ASP.NET Core and OpenIddict. Add passwordless login by email to your website or app over standard OpenID Connect (OIDC): a magic link with a QR code, or the one-tap email — the user sends a pre-filled email with one tap, nothing to type. Over SMTP, with inbound email from a provider webhook or IMAP; for users without a messaging app. Veriqa channel adapter (satellite package).</Description>
    <PackageTags>veriqa;authentication;openid-connect;oidc;openiddict;passwordless;passwordless-login;passwordless-authentication;login;auth;sign-in;qr-code;qr-code-login;cross-device-authentication;two-factor-authentication;2fa;mfa;step-up-authentication;sms-alternative;openid-connect-provider;oidc-server;identity-provider;sso;human-in-the-loop;ai-agent-security;device-flow;aspnetcore;email;email-login;email-auth;email-authentication;passwordless-email;magic-link;magic-link-login;one-tap-email;smtp;imap</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Redis satellite implements the store of the email completion, an internal port of this
         adapter: the port stays out of the public surface, and its only other implementation is the
         in-process default here. -->
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- The channel service tests drive the internal SMTP outbound sender directly: its connection
         state is the surface under test, and it has no public entry point of its own. Travelled here
         with the types it opens up. -->
    <!-- Test friends stay out of the packed assemblies: build/pack-core passes VeriqaPackaging=true. -->
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Redis.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" />
    <!-- Above the version MimeKit brings: 4.16.x resolves 10.0.0, under advisories
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7 (fixed in 10.0.13). Stated here so the consumers
         of this package get it as well. Drop once MimeKit itself depends on a fixed version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <!-- The Pull-mode letter embeds the sign-in QR as an inline image, so the channel encodes one
         itself rather than borrowing the page's. -->
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
  </ItemGroup>

</Project>

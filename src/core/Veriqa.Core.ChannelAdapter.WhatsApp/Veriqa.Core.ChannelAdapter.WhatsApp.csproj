<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Veriqa.Core.ChannelAdapter.WhatsApp</RootNamespace>
    <!-- Satellite package — the WhatsApp channel. Keeps its platform SDK out of the base package's
         transitive graph, so a deployment that does not use WhatsApp never receives it. -->
    <IsPackable>true</IsPackable>
    <PackageId>Veriqa.Core.ChannelAdapter.WhatsApp</PackageId>
    <Authors>Veriqa</Authors>
    <Title>WhatsApp login and authentication for ASP.NET Core</Title>
    <Description>WhatsApp login and authentication for ASP.NET Core and OpenIddict. Add passwordless login with WhatsApp to your website or app over standard OpenID Connect (OIDC): users scan a QR code on a computer, TV or kiosk, or tap a button on the phone, and confirm in WhatsApp — no password, no SMS code. The same channel approves sensitive actions and AI agent steps. Delivery over the Meta Cloud API or Twilio. Veriqa channel adapter (satellite package).</Description>
    <PackageTags>veriqa;authentication;openid-connect;oidc;openiddict;passwordless;passwordless-login;passwordless-authentication;login;auth;sign-in;qr-code;qr-code-login;cross-device-authentication;two-factor-authentication;2fa;mfa;step-up-authentication;sms-alternative;openid-connect-provider;oidc-server;identity-provider;sso;human-in-the-loop;ai-agent-security;device-flow;aspnetcore;whatsapp;whatsapp-login;whatsapp-auth;whatsapp-authentication;sign-in-with-whatsapp;login-with-whatsapp;whatsapp-otp-alternative;whatsapp-cloud-api;whatsapp-business-api;twilio;twilio-whatsapp</PackageTags>
    <!-- Licensing: the server core and its satellites ship under the Mozilla Public License 2.0.
         MPL-2.0 is OSI-approved, so nuget.org takes it as a license expression and no license
         file has to travel inside the package. -->
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <!-- Shared package metadata: XML docs, repository metadata, embedded symbols, readme, validation. -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\Packaging.props" />

  <!-- Declared inventory of the public surface (PublicAPI.*.txt + RS0016/RS0017 as errors). -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\..\build\PublicApi.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The channel service tests drive this channel's own internals directly (its adapter, its bot
         information port, its client builder) — surfaces that are internal by design. The
         declaration travelled here with the types it opens up. -->
    <!-- Test friends stay out of the packed assemblies: build/pack-core passes VeriqaPackaging=true. -->
    <InternalsVisibleTo Include="Veriqa.Core.ChannelAdapter.Tests" Condition="'$(VeriqaPackaging)' != 'true'" />
  </ItemGroup>

  <!-- No platform SDK: the shipped providers talk to the Meta Cloud API and to the Twilio REST API
       over plain HTTP through IHttpClientFactory. -->

  <ItemGroup>
    <ProjectReference Include="..\Veriqa.Core.ChannelAdapter\Veriqa.Core.ChannelAdapter.csproj" />
  </ItemGroup>

</Project>

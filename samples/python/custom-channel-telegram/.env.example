# Reference Telegram adapter next to Veriqa — sample .env file.
# Copy this file to .env and replace every <placeholder> before running docker compose.
# NEVER commit a .env with real values to git.

# Transport secret of the channel, shared by Veriqa and the adapter: whsec_ followed by the base64 of
# 24 to 64 random bytes. Generate one with: echo "whsec_$(openssl rand -base64 32)"
VERIQA_TRANSPORT_SECRET=whsec_<base64 of 32 random bytes>

# Token of the bot from @BotFather: <bot id>:<secret part>.
TELEGRAM_BOT_TOKEN=<token from BotFather>

# How the adapter takes the updates of the bot in, and what Veriqa is told about it:
#   polling  -> VERIQA_INBOUND_VERIFICATION=outbound_fetch  (no public address needed)
#   webhook  -> VERIQA_INBOUND_VERIFICATION=shared_secret   (set TELEGRAM_PUBLIC_URL as well)
TELEGRAM_INBOUND_MODE=polling
VERIQA_INBOUND_VERIFICATION=outbound_fetch

# Webhook mode only: the public https address Telegram reaches the adapter at, without a trailing slash.
TELEGRAM_PUBLIC_URL=

# Optional: where the updates that are not answers to Veriqa go — the webhook of your own bot logic.
TELEGRAM_BOT_FORWARD_URL=

# Optional: the start of a sign-in by the code the sign-in window shows (see "Start by a code" in the README).
#   off       -> VERIQA_CODE_START_LINK_CARRIES_TRANSACTION empty  (no code; the default)
#   fallback  -> VERIQA_CODE_START_LINK_CARRIES_TRANSACTION=true   (the link still starts a sign-in)
#   only      -> VERIQA_CODE_START_LINK_CARRIES_TRANSACTION=false  (the link only opens the chat)
CODE_START=off
VERIQA_CODE_START_LINK_CARRIES_TRANSACTION=

# Reference WhatsApp adapter through Twilio next to Veriqa — sample .env file.
# Copy this file to .env and replace every <placeholder> before running docker compose.
# NEVER commit a .env with real values to git.

# Transport secret of the channel, shared by Veriqa and the adapter: whsec_ followed by the base64 of
# 24 to 64 random bytes. Generate one with: echo "whsec_$(openssl rand -base64 32)"
VERIQA_TRANSPORT_SECRET=whsec_<base64 of 32 random bytes>

# The Twilio account, from the Twilio Console: Account SID (AC followed by 32 hexadecimal digits) and
# Auth Token.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<Auth Token of the account>

# The WhatsApp sender of the account in E.164, for example the number of the WhatsApp Sandbox of Twilio.
TWILIO_WHATSAPP_FROM=<sender number in E.164: + and the digits>

# SID of the twilio/quick-reply content of the prompt (HX followed by 32 hexadecimal digits); see the README.
TWILIO_PROMPT_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The public https base address Twilio reaches the adapter at (your tunnel or reverse proxy to port 8000),
# without a trailing slash. The webhook of the sender is this address plus /twilio/<sender digits>.
TWILIO_PUBLIC_URL=https://<public address of the adapter>

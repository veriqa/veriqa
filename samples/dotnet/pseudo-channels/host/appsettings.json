{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Settings of the sample itself: the section belongs to this host, Veriqa neither knows nor binds
  // it. A provider with an empty ClientId is not registered as a channel at all, so the sample starts
  // with any subset of the two — the empty one included. Credentials and the relay secret come from
  // user secrets or environment variables (PseudoChannels__Google__ClientId and so on).
  "PseudoChannels": {
    // Address the PHONE reaches this host at: the channel link and the provider return URLs are
    // built on it. Behind a tunnel — the public address of the tunnel.
    "PublicBaseUrl": "https://localhost:7370",
    // Address this host reaches ITSELF at to post the signed relay webhook: the plain-HTTP loopback
    // endpoint of the launch profile, so the call neither leaves the machine nor depends on the
    // development certificate being trusted.
    "RelayBaseUrl": "http://localhost:5370",
    // Key of the HMAC the relay webhook is signed with. Empty — every webhook is rejected.
    "RelaySecret": "",
    // The relying-party half of the sample: the client the desktop page signs in as. Must name an
    // entry of Veriqa:OpenIddict:Clients below.
    "DesktopClientId": "pseudo-channels-desktop",
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Apple": {
      // The Services ID.
      "ClientId": "",
      "TeamId": "",
      "KeyId": "",
      // Content of the .p8 private key (PEM). The client secret Apple expects is a short-lived JWT
      // signed with it, made anew for every sign-in.
      "PrivateKey": ""
    }
  },
  "Veriqa": {
    "Channels": {
      "Telegram": { "Enabled": false, "InboundVerification": "shared_secret" },
      "WhatsApp": { "Enabled": false, "InboundVerification": "signature" },
      "Max": { "Enabled": false, "InboundVerification": "shared_secret" },
      "Email": { "Enabled": false, "InboundVerification": "shared_secret" },
      // The pseudo-channels state their inbound verification level like any channel does. The adapter
      // checks an HMAC-SHA256 of the raw webhook body (the X-Pseudo-Signature header) — the request
      // proves knowledge of the secret without presenting it, hence "signature".
      "google-id": { "InboundVerification": "signature" },
      "apple-id": { "InboundVerification": "signature" }
    },
    // Hop mode: the QR code carries an address of this node, and the node sends the phone on to the
    // channel link. Unified — one QR code for the page, the provider is chosen on the phone.
    "HopMode": {
      "Enabled": true,
      "QrMode": "Unified"
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 15
    },
    "OpenIddict": {
      "Server": {
        // With hop mode on, every hop URL is built on the issuer, so it has to be stated: an absolute
        // https address. Behind a tunnel — the public address (Veriqa__OpenIddict__Server__Issuer).
        "Issuer": "https://localhost:7370",
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        // The desktop page of this very host. A public client (no secret), so Veriqa requires PKCE.
        // Behind a tunnel the redirect URI moves to the public address as well
        // (Veriqa__OpenIddict__Clients__0__AllowedRedirectUris__0).
        {
          "ClientId": "pseudo-channels-desktop",
          "DisplayName": "Pseudo-channels sample",
          "AllowedRedirectUris": [ "https://localhost:7370/signin-oidc" ],
          "AllowedScopes": [ "openid", "email", "channel" ]
        }
      ]
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AcmeChat": {
    "WebhookSecret": "",
    "DeepLinkBaseUrl": "https://chat.acme.example/start",
    // Start of a sign-in by a code shown on the sign-in page. StartByCode — the link only opens the
    // chat and the code is the only start; CodeFallback — the link carries the transaction and the
    // code is a second way to start. Both off — the channel is started by its link alone.
    "StartByCode": false,
    "CodeFallback": false
  },
  "Veriqa": {
    "Channels": {
      "Telegram": { "Enabled": false, "InboundVerification": "shared_secret" },
      "WhatsApp": { "Enabled": false, "InboundVerification": "signature" },
      "Max": { "Enabled": false, "InboundVerification": "shared_secret" },
      "Email": { "Enabled": false, "InboundVerification": "shared_secret" },
      // The third-party channel of this sample declares its own inbound verification level, exactly
      // like a built-in one: the value belongs to the section of the channel, and the author of an SPI
      // adapter is the one who states it. AcmeChatChannelAdapter.ValidateWebhookAsync compares the
      // X-Acme-Signature header with the configured AcmeChat:WebhookSecret in constant time — a shared
      // secret presented by the incoming request, hence "shared_secret" and not "signature".
      "acme-chat": { "InboundVerification": "shared_secret" }
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 15
    },
    "OpenIddict": {
      "Server": {
        // The address the host is reached at, stated explicitly: a hop link in a QR code is built on
        // it, and a channel started by a code always gets one. It has to be an absolute https URL —
        // behind a tunnel, set it to the public address.
        "Issuer": "https://localhost:7320",
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        {
          "ClientId": "my-app",
          "DisplayName": "My Application",
          "AllowedRedirectUris": [ "https://localhost:7320/signin-oidc" ],
          "AllowedScopes": [ "openid", "profile", "email", "offline_access" ],
          "AllowRefreshTokens": true
        }
      ]
    }
  }
}

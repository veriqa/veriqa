{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veriqa": {
    // The six channels the sample registers. They ship disabled with empty credentials, as every
    // sample of the gallery does: a channel switched on without its credentials fails the start,
    // so `dotnet run` would stop working out of the box. Switch on the ones you have credentials
    // for — README.md has the command. The sign-in page offers those of them that the ui_config
    // record of the request lists — see UiConfigurations below.
    "Channels": {
      "Telegram": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "Max": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "BotToken": "",
        "UpdateMode": "Webhook",
        "WebhookBaseUrl": "",
        "WebhookSecretToken": ""
      },
      "WhatsApp": {
        "Enabled": false,
        "InboundVerification": "signature",
        "Provider": "MetaCloudApi",
        "BusinessPhoneNumber": "",
        "MetaCloudApi": {
          "PhoneNumberId": "",
          "AccessToken": "",
          "AppSecret": "",
          "WebhookVerifyToken": "",
          "GraphApiBaseUrl": "https://graph.facebook.com",
          "GraphApiVersion": "v26.0"
        }
      },
      "Instagram": {
        "Enabled": false,
        "InboundVerification": "signature",
        "AppSecret": "",
        "WebhookVerifyToken": "",
        "AccessToken": "",
        "AccountId": "",
        "Username": "",
        "GraphApiBaseUrl": "https://graph.instagram.com",
        "GraphApiVersion": "v26.0"
      },
      // GraphApiVersion has no default for this channel: an enabled Messenger does not start
      // without one.
      "Messenger": {
        "Enabled": false,
        "InboundVerification": "signature",
        "PageId": "",
        "PageName": "",
        "PageAccessToken": "",
        "AppSecret": "",
        "WebhookVerifyToken": "",
        "GraphApiBaseUrl": "https://graph.facebook.com",
        "GraphApiVersion": ""
      },
      "Email": {
        "Enabled": false,
        "InboundVerification": "shared_secret",
        "PullEnabled": true,
        "PushEnabled": false,
        "PublicBaseUrl": "https://localhost:7350",
        "TokenTtl": "00:05:00",
        "Outbound": {
          "Provider": "Smtp",
          "FromAddress": "",
          "FromName": "Nova Stream",
          "Smtp": {
            "Host": "",
            "Port": 587,
            "UseSsl": true,
            "RequireStartTls": true,
            "Username": "",
            "Password": ""
          }
        }
      },
      // Where the receipt of an outcome appears. For a sign-in the question is worth nothing once
      // answered, so the receipt takes its place: ReplacePrompt, the value the product ships with,
      // stated here so the sample shows the setting. A confirmation is different — see the backend
      // client below, which states NewMessage for itself.
      "OutcomeNotice": {
        "DisplayIntent": "ReplacePrompt"
      }
    },
    // The receipts of a sign-in name the application signed in to: {app} is the DisplayName of the
    // web client. They are stated for every surface the product words a sign-in on — email-confirm-page
    // included — because a level exhausts every step of the address before the resolution drops to
    // the level below, and a surface left out here would get the bare ladder of this level.
    // The receipts of a confirmation word the outcome of the action itself, per action type, from the
    // same slot values the question was asked with. ByAction sits under ByType:confirmation because no step of
    // the lookup names an action without its transaction type. The bare ladder is what any other
    // confirmation would get. A receipt reports the decision taken in the channel, not the result of the operation:
    // a confirmation by someone other than the expected person still reads as confirmed there,
    // and the backend refuses it afterwards — hence "confirmed", not "done".
    "MessageTemplates": {
      "outcome-receipt-confirmed": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerInitiatorContext" } ]
        },
        "Templates": [ "{app}: confirmed ✅", "Confirmed ✅" ],
        "ByType": {
          "login": {
            "BySurface": {
              "in-channel-messenger": {
                "Templates": [ "Sign-in to {app} confirmed ✅", "Sign-in confirmed ✅" ],
                "ByDevice": {
                  "mobile": {
                    "Templates": [ "Sign-in to {app} confirmed ✅ Tap Back to return to the sign-in page.", "Sign-in confirmed ✅ Tap Back to return to the sign-in page." ]
                  },
                  "tablet": {
                    "Templates": [ "Sign-in to {app} confirmed ✅ Tap Back to return to the sign-in page.", "Sign-in confirmed ✅ Tap Back to return to the sign-in page." ]
                  }
                }
              },
              "in-channel-plain": {
                "Templates": [ "Sign-in to {app} confirmed", "Sign-in confirmed" ],
                "ByDevice": {
                  "mobile": {
                    "Templates": [ "Sign-in to {app} confirmed. Tap Back to return to the sign-in page.", "Sign-in confirmed. Tap Back to return to the sign-in page." ]
                  },
                  "tablet": {
                    "Templates": [ "Sign-in to {app} confirmed. Tap Back to return to the sign-in page.", "Sign-in confirmed. Tap Back to return to the sign-in page." ]
                  }
                }
              },
              "email-confirm-page": {
                "Templates": [ "Sign-in to {app} confirmed! You can close this tab.", "Sign-in confirmed! You can close this tab." ]
              }
            }
          },
          "confirmation": {
            "ByAction": {
              "purchase-title": {
                "Contract": {
                  "Slots": [
                    { "Name": "title", "Type": "string", "MaxLength": 64 },
                    { "Name": "price", "Type": "string", "MaxLength": 16 }
                  ]
                },
                "Templates": [ "Purchase confirmed: “{title}” for {price} ✅", "Purchase confirmed ✅" ]
              }
            }
          }
        }
      },
      "outcome-receipt-declined": {
        "Contract": {
          "Slots": [ { "Name": "app", "Type": "string", "Source": "ServerInitiatorContext" } ]
        },
        "Templates": [ "{app}: declined ❌", "Declined ❌" ],
        "ByType": {
          "login": {
            "BySurface": {
              "in-channel-messenger": {
                "Templates": [ "Sign-in to {app} declined ❌", "Sign-in declined ❌" ]
              },
              "in-channel-plain": {
                "Templates": [ "Sign-in to {app} declined", "Sign-in declined" ]
              },
              "email-confirm-page": {
                "Templates": [ "Sign-in to {app} declined. You can close this tab.", "Sign-in declined. You can close this tab." ]
              }
            }
          },
          "confirmation": {
            "ByAction": {
              "purchase-title": {
                "Contract": {
                  "Slots": [
                    { "Name": "title", "Type": "string", "MaxLength": 64 },
                    { "Name": "price", "Type": "string", "MaxLength": 16 }
                  ]
                },
                "Templates": [ "Purchase of “{title}” cancelled ❌", "Purchase cancelled ❌" ]
              }
            }
          }
        }
      }
    },
    // The sign-in page is opened by the web client, the page behind the shared QR of a confirmation
    // by the backend client. Everything a record does not state falls through to the client and to
    // AuthPageDesign below.
    //
    // The web client has two records, alike in everything but Channels — which channels the sign-in
    // page offers, in this order. The sample picks one per request, by the first language of the
    // browser (Accept-Language): nova-sign-in-a for Russian, nova-sign-in-b for any other
    // language and for a request without the header; -b is also the client's default. A record only
    // NARROWS what the host has: a channel listed here and switched off above is not shown, and a
    // record none of whose channels is switched on leaves the page empty. The backend's record lists
    // no channels, so a confirmation can go to any of the six.
    "UiConfigurations": {
      "Records": {
        "nova-sign-in-a": {
          "Title": "Sign in with your messaging app",
          "Channels": [ "max", "telegram", "whatsapp", "email" ]
        },
        "nova-sign-in-b": {
          "Title": "Sign in with your messaging app",
          "Channels": [ "telegram", "whatsapp", "instagram", "messenger", "email" ]
        },
        "nova-purchase": {
          "Title": "Confirm your purchase"
        }
      }
    },
    // What a sign-in may ask for, and what Veriqa collects by itself. A catalog that is not empty
    // REPLACES the product's own set of scopes as a whole, so it lists every scope the two clients
    // below name in AllowedScopes — a scope left out stops the start. The standard scopes are stated
    // by name alone: their claims (name, picture, phone_number and the rest) are issued by the scope
    // being granted, without a row here.
    // The two rows are the claims no channel gives. Veriqa asks for them on a form of its own, inside
    // the sign-in, and the collected claims store remembers the answer: the date of birth is Required
    // (the sign-in does not complete without it), the genre Optional (asked once, may be skipped).
    // Label and the option labels are localization keys with no translation, so they are shown as
    // written. Each option Value is a genre of the catalogue in CatalogStore.cs, letter for letter:
    // the list here and the titles there are two halves of one declaration, and a value that matches
    // no title recommends nothing.
    "ScopesClaims": {
      "Scopes": [
        {
          "Name": "profile",
          "Claims": [
            {
              "Name": "birthdate",
              "Source": "Collected",
              "Level": "Required",
              "Completion": { "Label": "Date of birth", "Format": "Date" }
            }
          ]
        },
        { "Name": "email" },
        { "Name": "phone" },
        { "Name": "channel" },
        { "Name": "avatar" },
        { "Name": "offline_access" },
        {
          "Name": "preferences",
          "Claims": [
            {
              "Name": "preferred_genre",
              "Source": "Collected",
              "Level": "Optional",
              "Completion": {
                "Label": "Favourite genre",
                "Format": "Choice",
                "Options": [
                  { "Value": "Sci-Fi", "Label": "Sci-Fi" },
                  { "Value": "Drama", "Label": "Drama" },
                  { "Value": "Documentary", "Label": "Documentary" },
                  { "Value": "Thriller", "Label": "Thriller" },
                  { "Value": "Animation", "Label": "Animation" },
                  { "Value": "Western", "Label": "Western" },
                  { "Value": "Fantasy", "Label": "Fantasy" }
                ]
              }
            }
          ]
        }
      ]
    },
    "TransactionEngine": {
      "TransactionTtlSeconds": 300,
      "ConfirmationFinalizationTimeoutSeconds": 30,
      "CompletedRetentionSeconds": 600,
      "CleanupIntervalSeconds": 15
    },
    "OpenIddict": {
      "Server": {
        "AccessTokenLifetimeSeconds": 3600,
        "RefreshTokenLifetimeSeconds": 1209600,
        "AuthorizationCodeLifetimeSeconds": 300
      },
      "Clients": [
        // The viewer's browser. A public client (no secret), so Veriqa requires PKCE from it.
        {
          "ClientId": "nova-stream-tv",
          "DefaultUiConfig": "nova-sign-in-b",
          "AllowedUiConfigs": [ "nova-sign-in-a", "nova-sign-in-b" ],
          "DisplayName": "Nova Stream",
          "AllowedRedirectUris": [ "https://localhost:7350/signin-oidc" ],
          "AllowedScopes": [ "openid", "profile", "email", "phone", "channel", "avatar", "offline_access", "preferences" ],
          "AllowRefreshTokens": true,
          // The form that collects the date of birth and the genre opens on the phone that confirmed
          // the sign-in, by a link button in the chat — not on the television, where a date would be
          // typed with a remote. Where the channel cannot show such a button the core falls back to
          // the sign-in page by itself.
          "ClaimCompletionFormSurface": "CrossDevicePage"
        },
        // The backend half: it creates the purchase confirmations and reads their results.
        {
          "ClientId": "nova-stream-backend",
          "DefaultUiConfig": "nova-purchase",
          "AllowedUiConfigs": [ "nova-purchase" ],
          "ClientSecret": "",
          "AllowClientCredentials": true,
          "AllowConfirmationTokenGrant": true,
          "AllowedScopes": [ "openid", "channel" ],
          // The confirmations are created by this client, so its entry is the level their receipt is
          // resolved at. A confirmation asks about one specific action, and the wording of that
          // question IS the record of what was approved: NewMessage keeps it and adds the receipt as
          // a message of its own, while a sign-in keeps the ReplacePrompt of the global section.
          "OutcomeNoticeDisplayIntent": "NewMessage",
          // Who a confirmation may be addressed to. One entry per channel the sample registers: the
          // claim is the same for all six, the normalisation rule is what differs. A confirmation
          // naming a type that is not declared here is refused with candidate_type_undeclared.
          "IdentityMatchComparableTypes": [
            { "Name": "telegram_user_id", "ClaimName": "channel_user_id", "Normalization": "Exact" },
            { "Name": "whatsapp_user_id", "ClaimName": "channel_user_id", "Normalization": "Exact" },
            { "Name": "max_user_id", "ClaimName": "channel_user_id", "Normalization": "Exact" },
            { "Name": "instagram_user_id", "ClaimName": "channel_user_id", "Normalization": "Exact" },
            { "Name": "messenger_user_id", "ClaimName": "channel_user_id", "Normalization": "Exact" },
            { "Name": "email_address", "ClaimName": "channel_user_id", "Normalization": "EmailDomainCaseFold" }
          ],
          "MessageTemplates": {
            "purchase-title": {
              "Contract": {
                "Slots": [
                  { "Name": "title", "Type": "string", "MaxLength": 64, "Required": true },
                  { "Name": "price", "Type": "string", "MaxLength": 16, "Required": true }
                ]
              },
              "Templates": [
                "Buy “{title}” for {price}?",
                "Confirm this purchase?"
              ]
            }
          }
        }
      ]
    },
    "AuthPageDesign": {
      "PrimaryColor": "#e50a5c",
      // Dark, stated rather than left to Auto: Auto follows the browser's colour-scheme setting, and a
      // television browser does not report a dark one — the page came up white next to the dark
      // screens of the sample itself.
      "Theme": "Dark",
      // The row over the card: the mark of Veriqa beside the name of the shop. Without a logo and a
      // name the page shows the product's own mark alone — right for a bare installation, wrong for
      // a sample pretending to be a streaming service.
      "BrandName": "Nova Stream",
      "LogoUrl": "/veriqa-mark.svg",
      // The sheet that fits the page to a television — see README.md: a card enlarged for a
      // full-HD screen, and the layout restated for old engines. A rooted path rather than an
      // absolute address: the page accepts one, and the sample then needs no variable of its own
      // when it moves behind a tunnel. The ?v suffix changes with the sheet, for the same reason as
      // in index.html: a cache in front may keep the old one for a year.
      "CustomCssPath": "/veriqa-auth-page-tv.css?v=6",
      // The QR is scanned off a television screen with a phone camera, from across the room, so it
      // is drawn larger than the default 6 px per module. The setting accepts 5…35.
      // DesktopOnly: a phone that opens this page — the shared QR of a confirmation scanned off the
      // screen leads here — is the device that would have to scan it, so it gets the channel
      // buttons instead of a QR it cannot photograph. The core tells a phone by a coarse pointer
      // AND a phone User-Agent; a television is neither, and keeps its QR. It is the shipped default
      // as well, stated here because the setting below is its other half.
      "QrCode": {
        "PixelsPerModule": 12,
        "ShowQrCode": "DesktopOnly"
      },
      // MobileOnly: the "Sign in with ..." buttons of the channels, the "Send confirmation email" one among
      // them, are shown on a phone and nowhere else. Across a room nobody can follow them, and the
      // way in on a television is the QR code. Together with DesktopOnly above every device keeps
      // exactly one way in: the QR on the television, the buttons on the phone.
      "ChannelButton": {
        "ShowChannelButton": "MobileOnly"
      },
      // Grid: the QR codes of all the channels on screen at once, side by side, instead of one at a
      // time behind tabs — nobody walks up to a television to switch a tab. The card of the page
      // grows to hold the row and a row that does not fit wraps. It arranges only what would
      // otherwise be tabs: a phone, which gets the channels as buttons, looks the same either way.
      "ChannelLayout": "Grid"
    }
  },
  "StreamingTvSample": {
    // Base address of the issuer this very process hosts. Behind a tunnel, set this and
    // Veriqa__OpenIddict__Server__Issuer to the public address — see README.md.
    "Authority": "https://localhost:7350",
    "WebClientId": "nova-stream-tv",
    "ClientId": "nova-stream-backend",
    "ClientSecret": "",
    "ActionType": "purchase-title"
  }
}

{
  "chains": {
    "agent-costly-run": [
      "developer",
      "manager"
    ]
  },
  "rules": [
    {
      "id": "git-push",
      "event": "tool.call",
      "tool": "^(Bash|PowerShell)$",
      "input": {
        "command": "\\bgit\\s+push\\b"
      },
      "action_type": "agent-tool-call",
      "slots": {
        "action": "push the branch to the remote repository",
        "tool": "{tool}",
        "target": "{input.command}",
        "project": "{project}"
      }
    },
    {
      "id": "recursive-delete",
      "event": "tool.call",
      "tool": "^(Bash|PowerShell)$",
      "input": {
        "command": "\\brm\\s+-[a-zA-Z]*[rR]|\\b([Rr]emove-[Ii]tem|ri|rd|rmdir|del|erase)\\b[^;|&\\n]*\\s-[Rr]"
      },
      "action_type": "agent-tool-call",
      "slots": {
        "action": "delete files and folders recursively",
        "tool": "{tool}",
        "target": "{input.command}",
        "project": "{project}"
      }
    },
    {
      "id": "cycle-typed",
      "event": "command.run",
      "command": "^(cycle|cycle-chain)$",
      "action_type": "agent-command-start",
      "slots": {
        "command": "{command}",
        "arguments": "{args}",
        "project": "{project}",
        "started_by": "person"
      }
    },
    {
      "id": "cycle-by-agent",
      "event": "tool.call",
      "tool": "^Skill$",
      "input": {
        "skill": "^(cycle|cycle-chain)$"
      },
      "action_type": "agent-command-start",
      "slots": {
        "command": "{input.skill}",
        "arguments": "{input.args}",
        "project": "{project}",
        "started_by": "agent"
      }
    }
  ]
}

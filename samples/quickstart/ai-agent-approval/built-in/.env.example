# Copy to .env and fill in. .env is ignored by git - never commit real values.

# Token of your Telegram bot: create a bot with @BotFather (https://t.me/BotFather) and paste the
# token it gives you. Use a bot no other server polls - Telegram hands the updates to one poller only.
TELEGRAM_BOT_TOKEN=

# Secret of the support-agent client: any long random string. Veriqa and the clients both read it
# from this file.
CLIENT_SECRET=

# Password of the HTTPS certificate in certs/localhost.pfx (README, "Run it"). Any value.
CERT_PASSWORD=

# Copy to .env and fill in. .env is ignored by git - never commit real values.

# Token of your MAX bot: create a bot on the MAX partner platform (https://dev.max.ru/docs) and paste
# its token. Use a bot no other server polls - long polling hands the updates to one poller only.
MAX_BOT_TOKEN=

# Password of the HTTPS certificate you export into certs/localhost.pfx (README, "Run it").
# Any value; the same one goes into the export command.
CERT_PASSWORD=

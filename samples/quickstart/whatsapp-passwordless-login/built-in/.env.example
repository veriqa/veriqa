# Copy to .env and fill in. .env is ignored by git - never commit real values.
# The WhatsApp values come from your Meta app: https://developers.facebook.com/ -> your app ->
# WhatsApp -> API Setup.

# The number users send the sign-in message to, in E.164 format, e.g. +15551234567.
WHATSAPP_BUSINESS_PHONE_NUMBER=

# The phone number ID of that number (API Setup).
WHATSAPP_PHONE_NUMBER_ID=

# An access token of the app; a permanent one for anything beyond a quick test.
WHATSAPP_ACCESS_TOKEN=

# The app secret (App settings -> Basic): Veriqa checks the signature of every webhook call with it.
WHATSAPP_APP_SECRET=

# Any random string; paste the same one as the verify token of the webhook in the Meta console.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Password of the HTTPS certificate you export into certs/localhost.pfx (README, "Run it").
# Any value; the same one goes into the export command.
CERT_PASSWORD=

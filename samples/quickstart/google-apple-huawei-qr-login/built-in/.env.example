# Copy to .env and fill in. .env is ignored by git - never commit real values.

# Password of the HTTPS certificate in certs/localhost.pfx (README, "Run it"). Any value; the .NET
# export command takes the same one.
CERT_PASSWORD=

# The public https address of this stand: the base of the QR code link and of the return address you
# register with the provider. Empty means https://localhost:8443 - enough for Google on this machine.
# A phone or Apple needs an address from an HTTP tunnel (README, "Sign in from a phone").
PUBLIC_BASE_URL=

# A provider turns on when its client ID is set. Set at least one.

# Google: an OAuth client of the "Web application" type in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: the Services ID, the Team ID, and the private key for Sign in with Apple with its Key ID.
# The key is the text of the .p8 file in double quotes, one line with \n for line breaks:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# HUAWEI ID: the client ID and the client secret of a web app in AppGallery Connect.
HUAWEI_CLIENT_ID=
HUAWEI_CLIENT_SECRET=
